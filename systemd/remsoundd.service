[Unit]
Description=RemSound headless peer
Documentation=file:///usr/share/doc/remsoundd/README.md
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=notify
ExecStart=/usr/bin/remsoundd --config /etc/remsoundd/config.toml run
Restart=on-failure
RestartSec=3

# A dedicated system user (created by the package). It reads /etc/remsoundd/password, which is
# root:remsoundd 0640, and joins the remsound group so it can share the bridge socket with the
# Hermes gateway (add the gateway's user to remsound; it cannot read the password).
User=remsoundd
Group=remsoundd
SupplementaryGroups=remsound
StateDirectory=remsoundd
RuntimeDirectory=remsoundd
RuntimeDirectoryMode=0755
UMask=0007

# Hardening. The daemon needs UDP, its Unix socket and netlink (to list interfaces for broadcast).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
